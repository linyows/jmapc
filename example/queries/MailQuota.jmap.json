{
  "_doc": "MailQuota reports how much of the account's mail storage is used. An account may be under several quotas at once, so the filter narrows it to the one a mail client would show: the octets it is allowed for mail.",

  "methodCalls": [
    ["Quota/query", {
      "filter": {
        "operator": "AND",
        "conditions": [
          {"resourceType": "octets"},
          {"type": "Mail"}
        ]
      },
      "sort": [{"property": "used", "isAscending": false}]
    }, "search"],

    ["Quota/get", {
      "#ids": {"resultOf": "search", "name": "Quota/query", "path": "/ids"},
      "properties": ["id", "name", "scope", "used", "hardLimit", "warnLimit", "softLimit", "description"]
    }, "fetch"]
  ],

  "_returns": "fetch"
}
