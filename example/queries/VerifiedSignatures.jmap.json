{
  "doc": "VerifiedSignatures finds signed messages in a mailbox and reports what became of each signature. The server does the cryptography: the signature covers the raw message, which a client never sees once the server has taken it apart.",

  "methodCalls": [
    ["Email/query", {
      "filter": {
        "operator": "AND",
        "conditions": [
          {"inMailbox": "{{mailboxId}}"},
          {"hasSmime": true}
        ]
      },
      "sort": [{"property": "receivedAt", "isAscending": false}],
      "limit": "{{limit}}"
    }, "search"],

    ["Email/get", {
      "#ids": {"resultOf": "search", "name": "Email/query", "path": "/ids"},
      "properties": [
        "id", "subject", "from", "receivedAt",
        "smimeStatus", "smimeStatusAtDelivery", "smimeErrors", "smimeVerifiedAt"
      ]
    }, "fetch"]
  ],

  "returns": "fetch"
}
